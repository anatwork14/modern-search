{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anatwork14/modern-search/spec/ipc-v1.schema.json",
  "title": "ResearchOS stdio request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "command",
    "payload"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "command": {
      "enum": [
        "health",
        "search",
        "taxonomy"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "health",
              "taxonomy"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
